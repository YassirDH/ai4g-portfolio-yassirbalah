    {
      "parameters": {
        "jsCode": "const current = $json.current;\n\nconst pollutantIndexes = {\n  \"PM2.5\": current.european_aqi_pm2_5,\n  \"PM10\": current.european_aqi_pm10,\n  \"NO2\": current.european_aqi_nitrogen_dioxide,\n  \"O3\": current.european_aqi_ozone\n};\n\nconst dominantPollutant = Object.entries(pollutantIndexes)\n  .sort((a, b) => b[1] - a[1])[0][0];\n\nreturn {\n  time: current.time,\n  aqi: current.european_aqi,\n  pm2_5: current.pm2_5,\n  pm10: current.pm10,\n  no2: current.nitrogen_dioxide,\n  ozone: current.ozone,\n  dominant_pollutant: dominantPollutant\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "id": "34d8ab39-9177-4769-9c74-fe6b7c39b9bd",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "jsCode": "const aqi = $json.aqi;\n\nlet riskLevel;\nlet alertNeeded;\n\nif (aqi < 40) {\n  riskLevel = \"LOW\";\n  alertNeeded = false;\n} else if (aqi < 60) {\n  riskLevel = \"MODERATE\";\n  alertNeeded = true;\n} else if (aqi < 80) {\n  riskLevel = \"HIGH\";\n  alertNeeded = true;\n} else if (aqi <= 100) {\n  riskLevel = \"VERY HIGH\";\n  alertNeeded = true;\n} else {\n  riskLevel = \"EXTREME\";\n  alertNeeded = true;\n}\n\nreturn {\n  ...$json,\n  risk_level: riskLevel,\n  alert_needed: alertNeeded\n};"
      },
