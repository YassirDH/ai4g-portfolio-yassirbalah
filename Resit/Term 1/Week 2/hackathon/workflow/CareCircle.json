    {
      "parameters": {
        "promptType": "define",
        "text": "=You are CareCircle, an assistant that keeps a shared care log for a family who care for an older relative at home. You never give medical advice, diagnoses or medication advice.\n\nCARE PROFILE:\n{{ $json.care_profile }}\n\nTODAY: {{ $json.timestamp }}\n\nNEW MESSAGE from {{ $json.sender }}:\n\"\"\"{{ $json.text }}\"\"\"\n\nAnalyse the message. Reply with ONLY one JSON object, no markdown and no explanation, in exactly this shape:\n{\n  \"is_care_update\": true,\n  \"categories\": [\"medication\"],\n  \"urgency\": \"routine\",\n  \"summary\": \"\",\n  \"tasks\": [{\"task\": \"\", \"owner\": \"\", \"due\": \"\"}],\n  \"follow_up\": \"\"\n}\n\nFIELDS\n- is_care_update: false if the message is not about care (e.g. \"hi\", \"thanks\", \"ok\"), otherwise true.\n- categories: one or more of medication, nutrition, fall_or_injury, cognition, mood, sleep, mobility, appointment, hygiene, social, caregiver_strain, other.\n- urgency: \"urgent\", \"attention\" or \"routine\" (rules below).\n- summary: one neutral sentence in English, max 25 words, only facts that are in the message.\n- tasks: only tasks that clearly need doing. owner = a name from the care team only if the message says who will do it or the sender volunteers, otherwise \"unassigned\". due = YYYY-MM-DD if a day is mentioned, otherwise \"\". Empty array if there are no tasks.\n- follow_up: one short question to the sender if important information is missing (for example whether the evening medication was taken), otherwise \"\".\n\nURGENCY RULES\n- urgent: possible emergency or sudden change: a fall, injury, chest pain, breathing problems, not responding, sudden severe confusion, wandering off or missing, no food or drink for more than a day, a possible medication overdose or mix-up.\n- attention: something the family should act on or watch: missed medication, eating poorly, increasing forgetfulness, low mood, an appointment or errand to arrange, a caregiver who sounds exhausted or overwhelmed.\n- routine: a normal update with nothing to act on.\n- If you are unsure between two levels, choose the higher one.\n\nOTHER RULES\n- Messages may be in Dutch or English. Always write summary, tasks and follow_up in English.\n- Never invent facts. Never suggest starting, stopping or changing medication."
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1616,
        -192
      ],
      "id": "f2dfc62b-a97a-40db-8cdf-93957968c8b9",
      "name": "Understand Update (AI)"
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1616,
        32
      ],
      "id": "de0ac1c5-6d05-47dc-9a80-d2b73e0e4245",
      "name": "Gemini Model",
      "credentials": {
        "googlePalmApi": {
          "id": "687n9WTkmded8qwL",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// SAFETY NET: code checks the AI. Code always has the final say on escalation.\nconst input = $('Prepare Message').item.json;\nconst raw = String($json.text || '').replace(/```json|```/g, '').trim();\n\nlet ai;\nlet parseError = false;\ntry {\n  ai = JSON.parse(raw.slice(raw.indexOf('{'), raw.lastIndexOf('}') + 1));\n} catch (e) {\n  parseError = true;\n  ai = {\n    is_care_update: true,\n    categories: ['other'],\n    urgency: 'attention',\n    summary: 'CareCircle could not interpret this message. Please read it yourself.',\n    tasks: [],\n    follow_up: ''\n  };\n}\n\nconst levels = ['routine', 'attention', 'urgent'];\nlet urgency = levels.includes(ai.urgency) ? ai.urgency : 'attention';\nlet override = parseError ? 'AI output unreadable, set to attention for a human check' : '';\n\n// Red-flag words (English + Dutch) ALWAYS escalate to urgent, whatever the AI decided.\nconst redFlags = [\n  /\\bfell\\b/, /\\bfallen\\b/, /\\bhad a fall\\b/, /\\bon the floor\\b/, /\\bunconscious\\b/,\n  /\\bunresponsive\\b/, /\\bnot responding\\b/, /\\bchest pain\\b/, /\\bcan'?t breathe\\b/,\n  /\\bshort of breath\\b/, /\\bbleeding\\b/, /\\bambulance\\b/, /\\b112\\b/, /\\bwent missing\\b/,\n  /\\bwandered off\\b/, /\\bgevallen\\b/, /\\bop de grond\\b/, /\\bbewusteloos\\b/,\n  /\\breageert niet\\b/, /\\bpijn op de borst\\b/, /\\bbenauwd\\b/, /\\bkortademig\\b/,\n  /\\bbloedt\\b/, /\\bvermist\\b/, /\\bweggelopen\\b/\n];\nconst text = String(input.text).toLowerCase();\nconst hit = redFlags.map(r => text.match(r)).find(m => m);\nif (hit && urgency !== 'urgent') {\n  urgency = 'urgent';\n  override = `Escalated by safety rule (keyword: \"${hit[0]}\")`;\n}\n\nlet route = urgency;\nif (!parseError && ai.is_care_update === false && !hit) route = 'ignore';\n\nconst tasks = (Array.isArray(ai.tasks) ? ai.tasks : [])\n  .filter(t => t && t.task)\n  .map(t => ({ task: String(t.task), owner: t.owner ? String(t.owner) : 'unassigned', due: t.due ? String(t.due) : '' }));\n\nreturn {\n  json: {\n    timestamp: input.timestamp,\n    sender: input.sender,\n    message: input.text,\n    chat_id: input.chat_id,\n    message_id: input.message_id,\n    categories: (Array.isArray(ai.categories) ? ai.categories : ['other']).join(', '),\n    urgency,\n    summary: String(ai.summary || ''),\n    follow_up: String(ai.follow_up || ''),\n    safety_override: override,\n    tasks,\n    route\n  }\n};"
      },
