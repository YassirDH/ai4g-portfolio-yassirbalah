    {
      "parameters": {
        "jsCode": "// Builds the facts for the weekly report. Code counts, AI interprets.\nconst now = DateTime.now().setZone('Europe/Amsterdam');\nconst weekStart = now.minus({ days: 7 });\n\nconst parse = v => {\n  const s = String(v || '');\n  let d = DateTime.fromFormat(s, 'yyyy-MM-dd HH:mm', { zone: 'Europe/Amsterdam' });\n  if (!d.isValid) d = DateTime.fromISO(s.replace(' ', 'T'), { zone: 'Europe/Amsterdam' });\n  return d;\n};\n\nconst log = $('Read Care Log').all().map(i => i.json).filter(r => r.timestamp);\nconst week = log.filter(r => { const d = parse(r.timestamp); return d.isValid && d >= weekStart; });\n\nconst count = (arr, key, split = false) => {\n  const out = {};\n  arr.forEach(r => {\n    const vals = split ? String(r[key] || '').split(',') : [r[key]];\n    vals.map(v => String(v || '').trim()).filter(Boolean).forEach(v => out[v] = (out[v] || 0) + 1);\n  });\n  return out;\n};\n\nconst tasks = $('Read Tasks').all().map(i => i.json).filter(t => t.task);\nconst open = tasks.filter(t => String(t.status || '').toLowerCase() !== 'done');\n\nconst reports = $('Read Last Report').all().map(i => i.json).filter(r => r.report);\nconst lastReport = reports.length ? reports[reports.length - 1].report : 'No previous report: this is the first week.';\n\nconst chatRow = [...log].reverse().find(r => r.chat_id);\nif (!chatRow) return []; // nothing logged yet, so there is no group to report to\n\nreturn [{\n  json: {\n    chat_id: String(chatRow.chat_id),\n    week_start: weekStart.toFormat('yyyy-MM-dd'),\n    week_end: now.toFormat('yyyy-MM-dd'),\n    total_updates: week.length,\n    by_category: JSON.stringify(count(week, 'categories', true)),\n    by_urgency: JSON.stringify(count(week, 'urgency')),\n    updates_by_person: JSON.stringify(count(week, 'sender')),\n    open_tasks_by_owner: JSON.stringify(count(open, 'owner')),\n    open_tasks: open.map(t => `- ${t.task} (owner: ${t.owner || 'unassigned'}${t.due ? ', due ' + t.due : ''})`).join('\\n') || 'none',\n    week_log: week.map(r => `[${r.timestamp}] ${r.sender} | ${r.urgency} | ${r.categories} | ${r.summary}`).join('\\n') || 'no updates this week',\n    last_report: lastReport\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
